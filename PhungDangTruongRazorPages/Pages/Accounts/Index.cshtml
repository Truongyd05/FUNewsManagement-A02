@page
@model PhungDangTruongRazorPages.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Accounts";
}

<div class="fnm-page-head">
    <h1 class="fnm-page-title">Accounts</h1>
    <button class="btn btn-success" data-modal-url="@Url.Page("Index", "Form")">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        New account
    </button>
</div>

<form method="get" class="row g-2 mb-4 fnm-filters">
    <div class="col-md-5">
        <input asp-for="Keyword" class="form-control" placeholder="Search name or email..." />
    </div>
    <div class="col-md-3">
        <select asp-for="Role" class="form-select">
            <option value="">All roles</option>
            <option value="1" selected="@(Model.Role == 1)">Staff</option>
            <option value="2" selected="@(Model.Role == 2)">Lecturer</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="fnm-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Accounts)
            {
                <tr>
                    <td class="text-muted">@a.AccountId</td>
                    <td>
                        <span class="d-inline-flex align-items-center gap-2">
                            <span class="fnm-avatar">@(string.IsNullOrEmpty(a.AccountName) ? "?" : a.AccountName.Substring(0, 1).ToUpperInvariant())</span>
                            @a.AccountName
                        </span>
                    </td>
                    <td>@a.AccountEmail</td>
                    <td>
                        @{
                            var roleName = AccountRole.GetName(a.AccountRole);
                        }
                        @if (roleName == "Staff") { <span class="badge bg-primary">Staff</span> }
                        else { <span class="badge bg-secondary">Lecturer</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary fnm-action-btn" data-modal-url="@Url.Page("Index", "Form", new { id = a.AccountId })">Edit</button>
                        <button class="btn btn-sm btn-outline-danger fnm-action-btn" data-modal-url="@Url.Page("Index", "DeleteForm", new { id = a.AccountId })">Delete</button>
                    </td>
                </tr>
            }
            @if (Model.Accounts.Count == 0)
            {
                <tr><td colspan="5" class="fnm-empty text-center text-muted">No accounts found.</td></tr>
            }
        </tbody>
    </table>
</div>
