@page
@model PhungDangTruongRazorPages.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Accounts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Accounts</h2>
    <button class="btn btn-success" data-modal-url="@Url.Page("Index", "Form")">+ New account</button>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5">
        <input asp-for="Keyword" class="form-control" placeholder="Search name or email..." />
    </div>
    <div class="col-md-3">
        <select asp-for="Role" class="form-select">
            <option value="">All roles</option>
            <option value="1" selected="@(Model.Role == 1)">Staff</option>
            <option value="2" selected="@(Model.Role == 2)">Lecturer</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var a in Model.Accounts)
        {
            <tr>
                <td>@a.AccountId</td>
                <td>@a.AccountName</td>
                <td>@a.AccountEmail</td>
                <td>@AccountRole.GetName(a.AccountRole)</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Page("Index", "Form", new { id = a.AccountId })">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Page("Index", "DeleteForm", new { id = a.AccountId })">Delete</button>
                </td>
            </tr>
        }
        @if (Model.Accounts.Count == 0)
        {
            <tr><td colspan="5" class="text-center text-muted">No accounts found.</td></tr>
        }
    </tbody>
</table>
