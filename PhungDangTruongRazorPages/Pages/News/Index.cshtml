@page
@model PhungDangTruongRazorPages.Pages.News.IndexModel
@{
    ViewData["Title"] = "News";
}

<div class="fnm-page-head">
    <h1 class="fnm-page-title">News</h1>
    <span class="text-muted small">@Model.Articles.Count result@(Model.Articles.Count == 1 ? "" : "s")</span>
</div>

<form method="get" class="row g-2 mb-4 fnm-filters">
    <div class="col-md-5">
        <input asp-for="Keyword" class="form-control" placeholder="Search title, headline, content or tag..." />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Search
        </button>
        <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div id="newsList">
    @if (Model.Articles.Count == 0)
    {
        <div class="fnm-empty card">
            <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <div class="fs-6">No news found.</div>
            <div class="small">Try a different keyword or category.</div>
        </div>
    }
    @foreach (var n in Model.Articles)
    {
        <article class="card fnm-news-card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <h5 class="card-title mb-1"><a asp-page="Details" asp-route-id="@n.NewsArticleId">@n.NewsTitle</a></h5>
                    @if (n.Category != null)
                    {
                        <span class="badge bg-primary">@n.Category.CategoryName</span>
                    }
                </div>
                <h6 class="card-subtitle mb-2 text-muted fw-normal">@n.Headline</h6>
                <p class="card-text small text-muted mb-2">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    @n.CreatedDate?.ToString("dd/MM/yyyy")
                    <span class="mx-1">·</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    @n.CreatedBy?.AccountName
                </p>
                @if (n.Tags.Any())
                {
                    <div class="mb-0">
                        @foreach (var t in n.Tags)
                        {
                            <span class="fnm-tag">@t.TagName</span>
                        }
                    </div>
                }
            </div>
        </article>
    }
</div>
