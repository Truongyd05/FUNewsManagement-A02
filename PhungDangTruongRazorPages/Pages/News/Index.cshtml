@page
@model PhungDangTruongRazorPages.Pages.News.IndexModel
@using BusinessObjects
@functions {
    static string Excerpt(string? text, int max)
    {
        if (string.IsNullOrWhiteSpace(text)) return string.Empty;
        var t = text.Replace("\r", " ").Replace("\n", " ").Trim();
        while (t.Contains("  ")) t = t.Replace("  ", " ");
        return t.Length <= max ? t : t.Substring(0, max).TrimEnd() + "…";
    }

    static string Initial(string? name) =>
        string.IsNullOrWhiteSpace(name) ? "?" : name.Trim().Substring(0, 1).ToUpperInvariant();

    // Some records repeat the title inside the headline; hide it when it adds nothing.
    static string? Subtitle(string? title, string? headline)
    {
        if (string.IsNullOrWhiteSpace(headline)) return null;
        if (!string.IsNullOrWhiteSpace(title) &&
            string.Equals(title.Trim(), headline.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }
        return headline.Trim();
    }
}
@{
    ViewData["Title"] = "News";

    var articles = Model.Articles;
    var categories = Model.Categories;
    var keyword = Model.Keyword;
    var selectedCategory = Model.CategoryId;
    var isFiltered = !string.IsNullOrWhiteSpace(keyword) || selectedCategory.HasValue;

    var categoryCounts = Model.CategoryCounts;
    var totalCount = Model.TotalCount;

    var featured = (!isFiltered && articles.Count > 0) ? articles[0] : null;
    var rest = featured != null ? articles.Skip(1).ToList() : articles;
    var sideStories = featured != null ? rest.Take(3).ToList() : new List<NewsArticle>();
    var listStories = featured != null ? rest.Skip(3).ToList() : rest;
    var topStories = articles.Take(5).ToList();

    var trendingTags = articles
        .SelectMany(n => n.Tags)
        .Where(t => !string.IsNullOrWhiteSpace(t.TagName))
        .GroupBy(t => t.TagName!)
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key)
        .Take(12)
        .ToList();

    var headingText = !string.IsNullOrWhiteSpace(keyword)
        ? $"Results for “{keyword}”"
        : selectedCategory.HasValue
            ? categories.FirstOrDefault(c => c.CategoryId == selectedCategory)?.CategoryName ?? "News"
            : "News";
}

@section SearchBar {
    <form method="get" class="fnm-searchbar" role="search">
        <div class="fnm-search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input name="keyword" value="@keyword" class="form-control" placeholder="Search news by title, headline, content or tag…" aria-label="Search news" />
        </div>
        <select name="categoryId" class="form-select" aria-label="Filter by category">
            <option value="">All categories</option>
            @foreach (var c in categories)
            {
                <option value="@c.CategoryId" selected="@(selectedCategory == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
    </form>
}

@if (featured != null)
{
    <section class="fnm-lead">
        <div class="row g-0">
            <div class="col-lg-8 fnm-lead-main">
                <span class="fnm-kicker">@(featured.Category?.CategoryName ?? "News")</span>
                <h1 class="fnm-lead-headline">
                    <a asp-page="Details" asp-route-id="@featured.NewsArticleId">@featured.NewsTitle</a>
                </h1>
                @{ var leadDeck = Subtitle(featured.NewsTitle, featured.Headline); }
                @if (leadDeck != null)
                {
                    <p class="fnm-lead-deck">@leadDeck</p>
                }
                <p class="fnm-lead-text">@Excerpt(featured.NewsContent, 330)</p>
                <div class="fnm-byline">
                    <span>By <strong>@(featured.CreatedBy?.AccountName ?? "FU News")</strong></span>
                    <span class="fnm-sep">·</span>
                    <span>@featured.CreatedDate?.ToString("dd MMM yyyy")</span>
                    <span class="fnm-sep">·</span>
                    <a class="fnm-readlink" asp-page="Details" asp-route-id="@featured.NewsArticleId">Read article &rsaquo;</a>
                </div>
            </div>

            @if (sideStories.Any())
            {
                <div class="col-lg-4 fnm-lead-side">
                    @foreach (var s in sideStories)
                    {
                        <article class="fnm-side-story">
                            <span class="fnm-kicker">@(s.Category?.CategoryName ?? "News")</span>
                            <h2 class="fnm-side-headline">
                                <a asp-page="Details" asp-route-id="@s.NewsArticleId">@s.NewsTitle</a>
                            </h2>
                            <div class="fnm-byline fnm-byline-sm">@s.CreatedDate?.ToString("dd MMM yyyy")</div>
                        </article>
                    }
                </div>
            }
        </div>
    </section>
}
else
{
    <div class="fnm-section-head">
        <h2>@headingText</h2>
        <span class="fnm-count">@articles.Count result@(articles.Count == 1 ? "" : "s")</span>
    </div>
}

@if (articles.Count == 0)
{
    <div class="fnm-empty">
        <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        <h4>No news found</h4>
        <div>Try a different keyword or category.</div>
    </div>
}
else
{
    <div class="row g-5">
        <div class="col-lg-8">
            <div class="fnm-section-head">
                <h2>@(featured != null ? "More news" : headingText)</h2>
                @if (featured == null)
                {
                    <span class="fnm-count">@articles.Count result@(articles.Count == 1 ? "" : "s")</span>
                }
            </div>

            @if (listStories.Count == 0)
            {
                <p class="text-muted">You have reached the end of the feed.</p>
            }
            else
            {
                foreach (var n in listStories)
                {
                    <article class="fnm-story-row">
                        <span class="fnm-kicker">@(n.Category?.CategoryName ?? "News")</span>
                        <h3 class="fnm-story-headline">
                            <a asp-page="Details" asp-route-id="@n.NewsArticleId">@n.NewsTitle</a>
                        </h3>
                        @{ var deck = Subtitle(n.NewsTitle, n.Headline); }
                        @if (deck != null)
                        {
                            <p class="fnm-story-deck">@deck</p>
                        }
                        <div class="fnm-byline fnm-byline-sm">
                            <span>@(n.CreatedBy?.AccountName ?? "FU News")</span>
                            <span class="fnm-sep">·</span>
                            <span>@n.CreatedDate?.ToString("dd MMM yyyy")</span>
                            @if (n.Tags.Any())
                            {
                                <span class="fnm-sep">·</span>
                                <span>@string.Join("  ", n.Tags.Take(3).Select(t => "#" + t.TagName))</span>
                            }
                        </div>
                    </article>
                }
            }
        </div>

        <aside class="col-lg-4">
            <div class="fnm-sidebar-block">
                <div class="fnm-section-head fnm-section-head-sm">
                    <h2>Top stories</h2>
                </div>
                <ol class="fnm-mostread">
                    @foreach (var s in topStories)
                    {
                        <li><a asp-page="Details" asp-route-id="@s.NewsArticleId">@s.NewsTitle</a></li>
                    }
                </ol>
            </div>

            <div class="fnm-sidebar-block">
                <div class="fnm-section-head fnm-section-head-sm">
                    <h2>Browse</h2>
                </div>
                <nav class="fnm-cat-list">
                    <a class="fnm-cat-link @(selectedCategory == null ? "active" : "")" asp-page="Index" asp-route-keyword="@keyword">
                        <span>All news</span>
                        <span class="fnm-cat-count">@totalCount</span>
                    </a>
                    @foreach (var c in categories)
                    {
                        categoryCounts.TryGetValue(c.CategoryId, out var count);
                        <a class="fnm-cat-link @(selectedCategory == c.CategoryId ? "active" : "")"
                           asp-page="Index" asp-route-categoryId="@c.CategoryId" asp-route-keyword="@keyword">
                            <span>@c.CategoryName</span>
                            <span class="fnm-cat-count">@count</span>
                        </a>
                    }
                </nav>
            </div>

            @if (trendingTags.Any())
            {
                <div class="fnm-sidebar-block">
                    <div class="fnm-section-head fnm-section-head-sm">
                        <h2>Topics</h2>
                    </div>
                    <div class="fnm-tag-cloud">
                        @foreach (var t in trendingTags)
                        {
                            <a class="fnm-tag" asp-page="Index" asp-route-keyword="@t.Key">@t.Key</a>
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
}
