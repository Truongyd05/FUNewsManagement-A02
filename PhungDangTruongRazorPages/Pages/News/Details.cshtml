@page "{id}"
@model PhungDangTruongRazorPages.Pages.News.DetailsModel
@{
    var a = Model.Article;
    ViewData["Title"] = a.NewsTitle;
}

<div class="fnm-article-wrap">
    <a asp-page="Index" class="fnm-backlink">&lsaquo; Back to news</a>

    <article class="fnm-article">
        <span class="fnm-kicker">@(a.Category?.CategoryName ?? "News")</span>
        <h1 class="fnm-article-title">@a.NewsTitle</h1>

        @if (!string.IsNullOrWhiteSpace(a.Headline))
        {
            <p class="fnm-article-standfirst">@a.Headline</p>
        }

        <div class="fnm-article-byline">
            <span>By <strong>@(a.CreatedBy?.AccountName ?? "FU News")</strong></span>
            <span class="fnm-sep">·</span>
            <span>@a.CreatedDate?.ToString("dd MMMM yyyy, HH:mm")</span>
            @if (!string.IsNullOrWhiteSpace(a.NewsSource))
            {
                <span class="fnm-sep">·</span>
                <span>Source: @a.NewsSource</span>
            }
            <span class="fnm-sep">·</span>
            <span class="fnm-status @(a.NewsStatus == true ? "is-active" : "")">@(a.NewsStatus == true ? "Active" : "Inactive")</span>
        </div>

        <div class="fnm-article-body">@a.NewsContent</div>

        @if (a.Tags.Any())
        {
            <div class="fnm-article-tags">
                @foreach (var t in a.Tags)
                {
                    <a class="fnm-tag" asp-page="Index" asp-route-keyword="@t.TagName">@t.TagName</a>
                }
            </div>
        }
    </article>
</div>
