@page "{id}"
@model PhungDangTruongRazorPages.Pages.News.DetailsModel
@{
    var a = Model.Article;
    ViewData["Title"] = a.NewsTitle;
}

<a asp-page="Index" class="btn btn-link ps-0 text-decoration-none">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Back to news
</a>

<article class="card">
    <div class="card-body p-4 p-md-5">
        <header class="mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                @if (a.Category != null)
                {
                    <span class="badge bg-primary">@a.Category.CategoryName</span>
                }
                <span class="badge bg-success">Active</span>
            </div>
            <h1 class="display-6 mb-2">@a.NewsTitle</h1>
            <p class="lead text-muted mb-3">@a.Headline</p>
            <p class="small text-muted mb-0">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                @a.CreatedDate?.ToString("dd/MM/yyyy HH:mm")
                <span class="mx-1">·</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                @a.CreatedBy?.AccountName
                <span class="mx-1">·</span>Source: @a.NewsSource
            </p>
        </header>

        <hr class="my-4" />

        <div class="fnm-article-body" style="white-space: pre-wrap; font-size: 1.05rem; line-height: 1.75">@a.NewsContent</div>

        @if (a.Tags.Any())
        {
            <div class="mt-4 pt-3 border-top">
                @foreach (var t in a.Tags)
                {
                    <span class="fnm-tag">@t.TagName</span>
                }
            </div>
        }
    </div>
</article>
