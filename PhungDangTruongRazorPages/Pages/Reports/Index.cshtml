@page
@model PhungDangTruongRazorPages.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Report";
}

<div class="fnm-page-head">
    <div>
        <span class="fnm-kicker">Statistics</span>
        <h1 class="fnm-page-title">News report</h1>
    </div>
</div>

<form method="get" class="fnm-filters row g-2 align-items-end">
    <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>
    <div class="col-md-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" required />
    </div>
    <div class="col-md-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" required />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            Generate report
        </button>
    </div>
</form>

@if (Model.Articles != null)
{
    var articles = Model.Articles;

    <div class="fnm-stats">
        <div>
            <div class="fnm-stat-num">@articles.Count</div>
            <div class="fnm-stat-label">Total articles</div>
        </div>
        <div>
            <div class="fnm-stat-num">@articles.Count(a => a.NewsStatus == true)</div>
            <div class="fnm-stat-label">Active</div>
        </div>
        <div>
            <div class="fnm-stat-num">@articles.Count(a => a.NewsStatus != true)</div>
            <div class="fnm-stat-label">Inactive</div>
        </div>
        <div>
            <div class="fnm-stat-num">@articles.Select(a => a.CreatedById).Distinct().Count()</div>
            <div class="fnm-stat-label">Authors</div>
        </div>
    </div>

    <div class="row g-5 mb-4">
        <div class="col-lg-6">
            <div class="fnm-section-head fnm-section-head-sm">
                <h2>By category</h2>
            </div>
            <table class="fnm-table">
                <thead><tr><th>Category</th><th class="fnm-cell-actions">Articles</th></tr></thead>
                <tbody>
                    @foreach (var g in articles.GroupBy(a => a.Category?.CategoryName ?? "(none)").OrderByDescending(g => g.Count()))
                    {
                        <tr><td>@g.Key</td><td class="fnm-cell-actions">@g.Count()</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="col-lg-6">
            <div class="fnm-section-head fnm-section-head-sm">
                <h2>By author</h2>
            </div>
            <table class="fnm-table">
                <thead><tr><th>Author</th><th class="fnm-cell-actions">Articles</th></tr></thead>
                <tbody>
                    @foreach (var g in articles.GroupBy(a => a.CreatedBy?.AccountName ?? "(unknown)").OrderByDescending(g => g.Count()))
                    {
                        <tr><td>@g.Key</td><td class="fnm-cell-actions">@g.Count()</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="fnm-section-head">
        <h2>Articles</h2>
        <span class="fnm-count">Newest first</span>
    </div>
    <table class="fnm-table align-middle">
        <thead>
            <tr><th>ID</th><th>Title</th><th>Category</th><th>Author</th><th>Created</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var a in articles)
            {
                <tr>
                    <td class="fnm-cell-id">@a.NewsArticleId</td>
                    <td class="fnm-cell-title">@a.NewsTitle</td>
                    <td>@a.Category?.CategoryName</td>
                    <td>@a.CreatedBy?.AccountName</td>
                    <td class="fnm-cell-muted">@a.CreatedDate?.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (a.NewsStatus == true) { <span class="fnm-badge is-active">Active</span> }
                        else { <span class="fnm-badge is-muted">Inactive</span> }
                    </td>
                </tr>
            }
            @if (articles.Count == 0)
            {
                <tr><td colspan="6" class="fnm-empty text-center text-muted">No articles in this period.</td></tr>
            }
        </tbody>
    </table>
}
