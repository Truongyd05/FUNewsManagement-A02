<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FU News Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var role = User.GetRole();
    }
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-primary mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/News/Index">FU News Management</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/News/Index">News</a></li>
                        @if (role == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Accounts/Index">Accounts</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Reports/Index">Report</a></li>
                        }
                        @if (role == "Staff")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Categories/Index">Categories</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Manage/Articles">Manage News</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Manage/History">My News History</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Profile">Profile</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item"><span class="navbar-text me-3">@User.Identity.Name (@role)</span></li>
                            <li class="nav-item">
                                <form asp-page="/Account/Login" asp-page-handler="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Logout</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Account/Login">Login</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <div class="modal fade" id="appModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content"></div>
        </div>
    </div>
    <div id="toastHost" class="toast-container position-fixed top-0 end-0 p-3"></div>

    <footer class="border-top footer text-muted">
        <div class="container">&copy; 2026 - FU News Management System</div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
