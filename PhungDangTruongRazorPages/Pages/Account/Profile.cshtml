@page
@model PhungDangTruongRazorPages.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My profile";
    var a = Model.Account!;
}

<div class="fnm-page-head">
    <div>
        <span class="fnm-kicker">Account</span>
        <h1 class="fnm-page-title">My profile</h1>
    </div>
    <button class="btn btn-primary" data-modal-url="@Url.Page("Profile", "Form")">Edit profile</button>
</div>

<div class="fnm-profile">
    <div class="fnm-profile-head">
        <span class="fnm-avatar">@(string.IsNullOrEmpty(a.AccountName) ? "?" : a.AccountName.Substring(0, 1).ToUpperInvariant())</span>
        <div>
            <div class="fnm-profile-name">@a.AccountName</div>
            <span class="fnm-badge is-active">@AccountRole.GetName(a.AccountRole)</span>
        </div>
    </div>

    <dl class="fnm-dl">
        <dt>ID</dt><dd>@a.AccountId</dd>
        <dt>Name</dt><dd>@a.AccountName</dd>
        <dt>Email</dt><dd>@a.AccountEmail</dd>
        <dt>Role</dt><dd>@AccountRole.GetName(a.AccountRole)</dd>
    </dl>
</div>
