@page
@model PhungDangTruongRazorPages.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "My profile";
    var a = Model.Account!;
}

<h2>My profile</h2>
<div class="card" style="max-width: 560px">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID</dt><dd class="col-sm-8">@a.AccountId</dd>
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@a.AccountName</dd>
            <dt class="col-sm-4">Email</dt><dd class="col-sm-8">@a.AccountEmail</dd>
            <dt class="col-sm-4">Role</dt><dd class="col-sm-8">@AccountRole.GetName(a.AccountRole)</dd>
        </dl>
    </div>
    <div class="card-footer">
        <button class="btn btn-primary" data-modal-url="@Url.Page("Profile", "Form")">Edit profile</button>
    </div>
</div>
