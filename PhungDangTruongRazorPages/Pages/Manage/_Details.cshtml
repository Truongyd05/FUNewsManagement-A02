@model NewsArticle

<div class="modal-header">
    <h5 class="modal-title">@Model.NewsTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    @if (!string.IsNullOrWhiteSpace(Model.Headline))
    {
        <p class="fnm-article-standfirst">@Model.Headline</p>
    }
    <p class="fnm-byline mb-3">
        @Model.Category?.CategoryName
        <span class="fnm-sep">·</span> Created @Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") by @Model.CreatedBy?.AccountName
        <span class="fnm-sep">·</span> Modified @Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm")
        @if (!string.IsNullOrWhiteSpace(Model.NewsSource))
        {
            <span class="fnm-sep">·</span> <span>Source: @Model.NewsSource</span>
        }
        <span class="fnm-sep">·</span>
        <span class="fnm-status @(Model.NewsStatus == true ? "is-active" : "")">@(Model.NewsStatus == true ? "Active" : "Inactive")</span>
    </p>
    <div class="fnm-body-plain">@Model.NewsContent</div>
    <div class="mt-3">
        @foreach (var t in Model.Tags)
        {
            <span class="fnm-tag">@t.TagName</span>
        }
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
</div>
