@model NewsArticle

<div class="modal-header">
    <h5 class="modal-title">@Model.NewsTitle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <p class="lead">@Model.Headline</p>
    <p class="text-muted small">
        @Model.Category?.CategoryName · Created @Model.CreatedDate?.ToString("dd/MM/yyyy HH:mm") by @Model.CreatedBy?.AccountName
        · Modified @Model.ModifiedDate?.ToString("dd/MM/yyyy HH:mm") · Source: @Model.NewsSource ·
        @(Model.NewsStatus == true ? "Active" : "Inactive")
    </p>
    <div style="white-space: pre-wrap">@Model.NewsContent</div>
    <div class="mt-3">
        @foreach (var t in Model.Tags)
        {
            <span class="badge bg-secondary">@t.TagName</span>
        }
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
</div>
