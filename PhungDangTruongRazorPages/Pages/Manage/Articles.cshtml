@page
@model PhungDangTruongRazorPages.Pages.Manage.ArticlesModel
@{
    ViewData["Title"] = "Manage news";
}

<div class="fnm-page-head">
    <div>
        <span class="fnm-kicker">Newsroom</span>
        <h1 class="fnm-page-title">Manage news</h1>
    </div>
    <button class="btn btn-primary" data-modal-url="@Url.Page("Articles", "Form")">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-2px"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        New article
    </button>
</div>

<form method="get" class="fnm-filters row g-2 align-items-center">
    <div class="col-md-4">
        <input name="keyword" value="@Model.Keyword" class="form-control" placeholder="Search title, headline, content or tag…" aria-label="Search articles" />
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select" aria-label="Category">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.Status == true)">Active</option>
            <option value="false" selected="@(Model.Status == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Articles" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div id="newsList">
    <partial name="_ArticleTable" model="Model.Articles" />
</div>
