@page
@model PhungDangTruongRazorPages.Pages.Manage.HistoryModel
@{
    ViewData["Title"] = "My news history";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">My news history</h2>
    <button class="btn btn-success" data-modal-url="@Url.Page("Articles", "Form")">+ New article</button>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input asp-for="Keyword" class="form-control" placeholder="Search title, headline, content or tag..." />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.Status == true)">Active</option>
            <option value="false" selected="@(Model.Status == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="History" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div id="newsList">
    <partial name="_ArticleTable" model="Model.Articles" />
</div>
