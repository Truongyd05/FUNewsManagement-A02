@page
@model PhungDangTruongRazorPages.Pages.Manage.HistoryModel
@{
    ViewData["Title"] = "My news history";
}

<div class="fnm-page-head">
    <h1 class="fnm-page-title">My news history</h1>
    <button class="btn btn-success" data-modal-url="@Url.Page("Articles", "Form")">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        New article
    </button>
</div>

<form method="get" class="row g-2 mb-4 fnm-filters">
    <div class="col-md-4">
        <input asp-for="Keyword" class="form-control" placeholder="Search title, headline, content or tag..." />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var c in Model.Categories)
            {
                <option value="@c.CategoryId" selected="@(Model.CategoryId == c.CategoryId)">@c.CategoryName</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <select asp-for="Status" class="form-select">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.Status == true)">Active</option>
            <option value="false" selected="@(Model.Status == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="History" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div id="newsList" class="fnm-table-wrap">
    <partial name="_ArticleTable" model="Model.Articles" />
</div>
