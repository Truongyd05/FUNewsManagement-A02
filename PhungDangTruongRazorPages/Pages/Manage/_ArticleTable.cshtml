@model List<NewsArticle>

<table class="table table-striped table-hover align-middle">
    <thead>
        <tr><th>ID</th><th>Title</th><th>Category</th><th>Tags</th><th>Created</th><th>Author</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td>@n.NewsArticleId</td>
                <td>@n.NewsTitle</td>
                <td>@n.Category?.CategoryName</td>
                <td>@string.Join(", ", n.Tags.Select(t => t.TagName))</td>
                <td>@n.CreatedDate?.ToString("dd/MM/yyyy")</td>
                <td>@n.CreatedBy?.AccountName</td>
                <td>
                    @if (n.NewsStatus == true) { <span class="badge bg-success">Active</span> }
                    else { <span class="badge bg-secondary">Inactive</span> }
                </td>
                <td class="text-end text-nowrap">
                    <button class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Page("/Manage/Articles", "Details", new { id = n.NewsArticleId })">View</button>
                    <button class="btn btn-sm btn-outline-primary" data-modal-url="@Url.Page("/Manage/Articles", "Form", new { id = n.NewsArticleId })">Edit</button>
                    <button class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Page("/Manage/Articles", "DeleteForm", new { id = n.NewsArticleId })">Delete</button>
                </td>
            </tr>
        }
        @if (Model.Count == 0)
        {
            <tr><td colspan="8" class="text-center text-muted">No news articles found.</td></tr>
        }
    </tbody>
</table>
