@page
@model PhungDangTruongRazorPages.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Categories";
}

<div class="fnm-page-head">
    <h1 class="fnm-page-title">Categories</h1>
    <button class="btn btn-success" data-modal-url="@Url.Page("Index", "Form")">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
        New category
    </button>
</div>

<form method="get" class="row g-2 mb-4 fnm-filters">
    <div class="col-md-5">
        <input asp-for="Keyword" class="form-control" placeholder="Search name or description..." />
    </div>
    <div class="col-md-3">
        <select asp-for="IsActive" class="form-select">
            <option value="">All statuses</option>
            <option value="true" selected="@(Model.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<div class="fnm-table-wrap">
    <table class="table table-hover align-middle">
        <thead>
            <tr><th>ID</th><th>Name</th><th>Description</th><th>Parent</th><th>Articles</th><th>Status</th><th class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td class="text-muted">@c.CategoryId</td>
                    <td class="fw-semibold">@c.CategoryName</td>
                    <td class="text-muted">@c.CategoryDesciption</td>
                    <td>@(c.ParentCategoryId == c.CategoryId ? "—" : c.ParentCategory?.CategoryName)</td>
                    <td>
                        <span class="badge bg-light text-dark border">@(Model.Counts.TryGetValue(c.CategoryId, out var n) ? n : 0)</span>
                    </td>
                    <td>
                        @if (c.IsActive == true) { <span class="badge bg-success">Active</span> }
                        else { <span class="badge bg-secondary">Inactive</span> }
                    </td>
                    <td class="text-end text-nowrap">
                        <button class="btn btn-sm btn-outline-primary fnm-action-btn" data-modal-url="@Url.Page("Index", "Form", new { id = c.CategoryId })">Edit</button>
                        <button class="btn btn-sm btn-outline-danger fnm-action-btn" data-modal-url="@Url.Page("Index", "DeleteForm", new { id = c.CategoryId })">Delete</button>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="7" class="fnm-empty text-center text-muted">No categories found.</td></tr>
            }
        </tbody>
    </table>
</div>
